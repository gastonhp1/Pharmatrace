# Copy to backend/.env and fill in. Never commit the real .env.
PORT=3001
RPC_URL=http://127.0.0.1:8545

# Contract addresses printed by the deploy scripts
CONTRACT_ADDRESS=
CARGO_CONTRACT_ADDRESS=

# One private key per actor. The API signs each operation with the key of the
# batch/cargo's current owner, so an owner without a key here cannot act through the API.
# MANUFACTURER_KEY must be the account that deployed DrugTracker (it is the contract owner).
MANUFACTURER_KEY=
DISTRIBUTOR_KEY=
WAREHOUSE_KEY=
PHARMACY_KEY=
PATIENT_KEY=
