# Copy to backend/.env and fill in. Never commit the real .env.
PORT=3001
RPC_URL=http://127.0.0.1:8545

# Shared secret for the write endpoints (POST). Clients send it in the x-api-key header.
# Without it the API refuses writes (503); AUTH_DISABLED=true skips the check (local dev only).
API_KEY=
# AUTH_DISABLED=true

# Contract addresses printed by the deploy scripts
CONTRACT_ADDRESS=
CARGO_CONTRACT_ADDRESS=

# One private key per actor. The API signs each operation with the key of the
# batch/cargo's current owner, so an owner without a key here cannot act through the API.
# MANUFACTURER_KEY must be the account that deployed DrugTracker (it is the contract owner).
MANUFACTURER_KEY=
DISTRIBUTOR_KEY=
WAREHOUSE_KEY=
PHARMACY_KEY=
PATIENT_KEY=
