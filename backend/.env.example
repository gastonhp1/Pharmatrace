# Copy to backend/.env and fill in. Never commit the real .env.
PORT=3001
RPC_URL=http://127.0.0.1:8545

# Shared secret for the write endpoints (POST). Clients send it in the x-api-key header.
# Without it the API refuses writes (503); AUTH_DISABLED=true skips the check (local dev only).
API_KEY=
# AUTH_DISABLED=true

# Contract addresses printed by the deploy scripts
CONTRACT_ADDRESS=
CARGO_CONTRACT_ADDRESS=
# IoT cold chain (printed by `npm run deploy:iot`). The IoT routes answer 503 until set.
DEVICE_REGISTRY_ADDRESS=
COLD_CHAIN_MONITOR_ADDRESS=

# One private key per actor. The API signs each operation with the key of the
# batch/cargo's current owner, so an owner without a key here cannot act through the API.
# MANUFACTURER_KEY must be the account that deployed DrugTracker (it is the contract owner).
MANUFACTURER_KEY=
DISTRIBUTOR_KEY=
WAREHOUSE_KEY=
PHARMACY_KEY=
PATIENT_KEY=

# --- IoT gateway (all optional) ---
# Account that attests readings on-chain. It has to be an attestor in DeviceRegistry and have
# funds for gas. If empty, MANUFACTURER_KEY signs.
IOT_GATEWAY_KEY=
# Optional separate key for the routes that send transactions (devices, policies, monitoring,
# anchor). If empty, API_KEY is used. Uploading readings never needs a key.
IOT_API_KEY=
# Where accepted readings are stored (default: backend/data/iot)
IOT_DATA_DIR=
# Nominal sampling period of the devices, used to account for the last reading of a window
IOT_SAMPLE_SECONDS=60
# How far ahead of the gateway's clock a device timestamp may be before it is rejected
IOT_MAX_CLOCK_SKEW_SECONDS=30
# Anchor pending readings every N seconds (0 or empty: only when POST /api/iot/cargo/:id/anchor is called)
IOT_ANCHOR_INTERVAL_SECONDS=0
