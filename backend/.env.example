# Copy to backend/.env and fill in. Never commit the real .env.
PORT=3001

# Shared secret for the write endpoints (and for reading private commercial terms). Clients send
# it in the x-api-key header. Without it the API refuses writes (503); AUTH_DISABLED=true skips the
# check (local development only).
API_KEY=
# AUTH_DISABLED=true

# --- Fabric (defaults match fabric/network) ---
# Certificates and keys of the orgs, as generated by `./network.sh up`.
# FABRIC_ORGS_DIR=../fabric/network/organizations
# Where the peers listen (each org's peer keeps its port: Lab 7051, Dist 8051, Farma 9051, Reg 10051).
# FABRIC_PEER_HOST=localhost
# Or one endpoint per org, e.g. when the API runs next to the peers in Docker or Kubernetes:
# FABRIC_PEER_ENDPOINT_DIST=peer0.dist.pharmatrace.ar:8051
# FABRIC_CHANNEL=pharmatrace
# FABRIC_CHAINCODE=pharmatrace
# User the API acts as in each org
# FABRIC_USER=User1
# Org that registers new batches (lab, dist, farma or reg)
# MANUFACTURER_ORG=lab

# --- IoT gateway ---
# Identity that anchors readings (<org>:<user>). Its certificate has to carry
# pharmatrace.role=iot-gateway (fabric/network/scripts/pki.sh issues it), and the regulator has to
# accept its org once: POST /api/iot/gateway/authorize
IOT_GATEWAY_IDENTITY=dist:IotGateway
# Optional separate key for the IoT admin routes (devices, policies, monitoring, anchor). If
# empty, API_KEY is used. Uploading readings never needs a key.
IOT_API_KEY=
# Where accepted readings are stored (default: backend/data/iot)
IOT_DATA_DIR=
# Nominal sampling period of the devices, used to account for the last reading of a window
IOT_SAMPLE_SECONDS=60
# How far ahead of the gateway's clock a device timestamp may be before it is rejected
IOT_MAX_CLOCK_SKEW_SECONDS=30
# Anchor pending readings every N seconds (0 or empty: only when POST /api/iot/cargo/:id/anchor is called)
IOT_ANCHOR_INTERVAL_SECONDS=0

# --- Mobile app: users and PharmaBox unlock (iot/docs/BOX_UNLOCK.md) ---
# Secret that signs user sessions (HS256). Long and random: openssl rand -base64 48
SESSION_SECRET=
# Session lifetime in seconds (default 8 h)
SESSION_TTL_SECONDS=28800
# Users file (default backend/data/users.json). Manage it with: node scripts/user.js add <user> <MSP>
USERS_FILE=
# ECDSA P-256 key that signs unlock tokens. Its own key: not a Fabric identity, not a device key.
# Create it with: node scripts/unlock-key.js generate data/unlock-key.pem
UNLOCK_KEY_FILE=
# Lifetime of an unlock token in seconds (1..300, default 120; the box rejects longer ones)
UNLOCK_TOKEN_TTL_SECONDS=120
# Audit of every unlock decision, granted or denied (default backend/data/unlock-audit.jsonl)
UNLOCK_AUDIT_FILE=
